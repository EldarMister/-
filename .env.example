DATABASE_URL=postgres://sushi:sushi@localhost:5434/sushi_tochka
PORT=4000
API_HOST=127.0.0.1
TRUST_PROXY=
# Keep 0 when this process is public. Otherwise set both the hop count and exact proxy IP/CIDR allowlist.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_ADDRESSES=
EXTERNAL_PROTOCOL=
# Optional in production. Set only when the browser frontend is hosted on another HTTPS origin.
CORS_ORIGIN=http://localhost:3000
# Production requires a private random value of at least 32 characters.
JWT_SECRET=
# Production requires a unique password of at least 12 characters.
ADMIN_PASSWORD=
NIKITA_OTP_API_KEY=
# Optional emergency access: this phone enters without an SMS code. Keep empty unless explicitly needed.
OTP_BYPASS_PHONE=
# Optional service safeguards; defaults are 120 SMS requests/service and 15/client per 15 minutes.
OTP_SERVICE_LIMIT_PER_15_MINUTES=120
OTP_CLIENT_LIMIT_PER_15_MINUTES=15
ORDER_CLIENT_LIMIT_PER_10_MINUTES=30
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
NFT_TRANSFER_WEBHOOK_URL=
NFT_TRANSFER_WEBHOOK_TOKEN=
NODE_ENV=development
